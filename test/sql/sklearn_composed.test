# name: test/sql/sklearn_composed.test
# description: Composed examples (vgi_sklearn/composed_examples.py) return the rows their descriptions claim
# group: [vgi_sklearn]

require-env VGI_SKLEARN_WORKER

require vgi

statement ok
ATTACH 'sklearn' AS sklearn (TYPE vgi, LOCATION '${VGI_SKLEARN_WORKER}');

# KMEANS_VS_SPECIES
query III
SELECT round(sklearn.metrics.adjusted_rand_score(i.target, k.cluster), 3) AS adjusted_rand, round(sklearn.metrics.homogeneity_score(i.target, k.cluster), 3) AS homogeneity, round(sklearn.metrics.completeness_score(i.target, k.cluster), 3) AS completeness FROM sklearn.preprocessing.kmeans((SELECT sample_id, sepal_length_cm, sepal_width_cm, petal_length_cm, petal_width_cm FROM sklearn.datasets.iris()), id := 'sample_id', n_clusters := 3) AS k JOIN sklearn.datasets.iris AS i USING (sample_id);
----
0.73	0.751	0.765

# OOF_CONFUSION_MATRIX
query III
SELECT actual, predicted, count FROM sklearn.metrics.confusion_matrix((SELECT i.target AS species, p.prediction AS predicted_species FROM sklearn.models.cross_val_predict((SELECT sample_id, sepal_length_cm, sepal_width_cm, petal_length_cm, petal_width_cm, target FROM sklearn.datasets.iris()), estimator := 'logistic_regression', target := 'target', id := 'sample_id') AS p JOIN sklearn.datasets.iris AS i USING (sample_id)), actual := 'species', predicted := 'predicted_species') ORDER BY actual, predicted;
----
0	0	50
1	1	47
1	2	3
2	1	1
2	2	49

# SCALED_PCA_BY_SPECIES
query TRR
SELECT i.target_name, round(avg(p.component_1), 2) AS mean_pc1, round(avg(p.component_2), 2) AS mean_pc2 FROM sklearn.preprocessing.pca((SELECT * FROM sklearn.preprocessing.standard_scaler((SELECT sample_id, sepal_length_cm, sepal_width_cm, petal_length_cm, petal_width_cm FROM sklearn.datasets.iris()), id := 'sample_id')), id := 'sample_id', n_components := 2) AS p JOIN sklearn.datasets.iris AS i USING (sample_id) GROUP BY i.target_name ORDER BY mean_pc1;
----
setosa	-2.22	0.29
versicolor	0.5	-0.55
virginica	1.73	0.26

# KMEANS_SILHOUETTE
query R
SELECT round(silhouette_score, 3) AS silhouette FROM sklearn.metrics.silhouette_score((SELECT f.*, k.cluster FROM sklearn.preprocessing.kmeans((SELECT sample_id, sepal_length_cm, sepal_width_cm, petal_length_cm, petal_width_cm FROM sklearn.datasets.iris()), id := 'sample_id', n_clusters := 3) AS k JOIN (SELECT sample_id, sepal_length_cm, sepal_width_cm, petal_length_cm, petal_width_cm FROM sklearn.datasets.iris()) AS f USING (sample_id)), label := 'cluster', id := 'sample_id');
----
0.553
